# Keep the real key in .env on the server; never use VITE_ for secrets.
HYDE_API_KEY=
HYDE_BASE_URL=https://inference.hyde.tech/v1
HYDE_MODEL=hyde/glm-5.3-flash
HYDE_VERIFIER_MODEL=hyde/glm-5.3-flash
STUDENT_ROLL=23b4244
EQUATION8_DATA_DIR=.local-data
# Optional original provider for legacy media ingestion:
GEMINI_API_KEY=

# Set these to the actual equivalent-host domain/origin before deployment.
APP_ALLOWED_HOSTS=
APP_PUBLIC_ORIGIN=

# Stable deployment encryption secret; keep server-side. VERCEL=1 is automatic on Vercel.
SESSION_SECRET=
EQUATION8_STATELESS=0
